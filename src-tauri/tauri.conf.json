{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "axiom",
  "version": "1.0.0",
  "identifier": "com.neur0n-7.axiom",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axiom",
        "width": 1100,
        "height": 750,
        "minWidth": 700,
        "minHeight": 450,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/axiom-backend"
    ]
  }
}
